# Local development settings. In production these come from Render's environment, never from a file.
ENV=development
DATABASE_URL=postgresql+psycopg://femalogy:femalogy@localhost:5432/femalogy
# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (older .env files call this JWT_SECRET; both names work)
SECRET_KEY=replace-me
# encrypts check-in notes:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-me
# local dev servers allowed to call the API (ignored in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
